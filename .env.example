# API key of the demo Shablonix account (templates:read + documents:generate).
# Server-side only; the browser never sees it.
SHABLONIX_API_KEY=

# Production by default. Local stack: http://localhost:4892
SHABLONIX_API_URL=https://api.shablonix.online

# Template used by the Invoices tab "PDF" links.
SHABLONIX_INVOICE_TEMPLATE_ID=

# Public origin of this demo (e.g. https://crm-demo.shablonix.online). The editor
# iframe is locked to it. Leave empty in local dev to use the request origin.
DEMO_ORIGIN=
